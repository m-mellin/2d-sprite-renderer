{
  "name": "2d-sprite-renderer",
  "version": "1.0.5",
  "description": "2D-sprite-renderer is a small JavaScript-library for drawing and animating 2D-sprites on a HTMLCanvasElement.",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": ["src", "types", "!src/**/*.test.js"],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:match": "vitest run -t",
    "lint": "eslint ./src --cache",
    "lint:fix": "eslint ./src --cache --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier ./src --check",
    "clean:types": "node -e \"fs.rmSync('types',{recursive:true,force:true})\"",
    "build:types": "npm run clean:types && tsc",
    "prepublishOnly": "npm run build:types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-mellin/2d-sprite-renderer.git"
  },
  "keywords": [],
  "author": "Mattias Mellin <mattias.mellin@gmail.com>",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bugs": {
    "url": "https://github.com/m-mellin/2d-sprite-renderer/issues"
  },
  "homepage": "https://github.com/m-mellin/2d-sprite-renderer#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lnu/eslint-config": "^2.0.13",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.10",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
