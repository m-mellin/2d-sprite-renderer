@startuml spriteRenderer

class Sprite {
  - asset
  - xPos
  - yPos
  - width
  - height
  - region

  + Sprite(src, xPos, yPos, width, height, region)
  - setSpriteSize(width, height)
  + setImageSource(src)
  + get positionX()
  - set positionX(xPos)
  + get positionY()
  - set positionY(yPos)
  + get image()
  + get isLoaded()
  + waitForLoad()
  + get width()
  + get height()
  + get region()
  + set region()
}

class SpriteRenderer {
  - canvas
  - context
  - sprites
  - frame
  
  + SpriteRenderer(canvas)
  - setContext()
  + add(sprite)
  + remove(sprite)
  + clear()
  - clearCanvas()
  - scheduleRender()
  + render()
}

class ImageAsset {
  - {static} cache
  - image
  - isLoaded
  - loaded

  + ImageAsset(src)
  + getAsset(src)
  - createLoadPromise(src)
  - setImageSource(src)
  + get image()
  + get isLoaded()
  + waitForLoad()
}

class SpriteRegion {
  - sourceX
  - sourceY
  - width
  - height

  + SpriteRegion(sourceX, sourceY, width, height)
  + get sourceX()
  + get sourceY()
  + get width()
  + get height()
}

class SpriteAnimation {
  - frames
  - frameDuration
  - currentFrame = 0
  - elasped = 0

  + SpriteAnimation(frames, frameDuration)
  + update()
  - resetCurrentFrame()
  + get region
}


SpriteRenderer "1" --> "*" Sprite : uses
Sprite "*" --> "1" ImageAsset : uses
Sprite "1" *-- "0..1" SpriteRegion : has

@enduml