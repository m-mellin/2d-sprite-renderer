@startuml spriteRenderer

class Sprite {
  - asset
  - xPos
  - yPos
  - width
  - height
  - region

  + Sprite(src, xPos, yPos, width, height, region)
  - setSpriteSize(width, height)
  + setImageSource(src)
  + setPosition(xPos, yPos)
  + get positionX()
  - set positionX(xPos)
  + get positionY()
  - set positionY(yPos)
  + get image()
  + get isLoaded()
  + waitForLoad()
  + get width()
  + get height()
  + get region()

}

class SpriteRenderer {
  - canvas
  - context
  - sprites
  - frame
  
  + SpriteRenderer(canvas)
  - setContext()
  + add(sprite)
  + remove(sprite)
  + clear()
  - clearCanvas()
  + scheduleRender()
  + render()
}

class ImageAsset {
  - cache
  - image
  - isLoaded
  - loaded

  + ImageAsset(src)
  + get(src)
  - createLoadPromise(src)
  - setImageSource(src)
  + get image()
  + get isLoaded()
  + waitForLoad()
}

class SpriteRegion {
  - sourceX
  - sourceY
  - width
  - height

  + SpriteRegion(sourceX, sourceY, width, height)
  + get sourceX()
  + get sourceY()
  + get width()
  + get height()
}


@enduml